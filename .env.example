# Copy the values you need into an untracked env file.
# Mobile: apps/mobile/.env
# Web:    apps/web/.env.local
# Do not commit those files. Do not put a service-role key in either app.
# Recording works with both values empty.

# Supabase Dashboard → Project Settings → API
# The anon key is public. Never put the service-role key in the phone app
# or in a NEXT_PUBLIC_ / EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Set these in the worker host's dashboard, not in git.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# MEMOAI_WORKER_SECRET=
# Leave MEMOAI_ALLOW_PROVIDER unset. Set it to 1 only for an intentional paid run.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_NOTES_MODEL=gpt-4.1-mini
