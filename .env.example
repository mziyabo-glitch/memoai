# Copy the values you need into an untracked env file.
# Mobile: apps/mobile/.env
# Web:    apps/web/.env.local
# Do not commit those files. Do not put a service-role key in either app.
# Recording works with both values empty.

# Supabase Dashboard → Project Settings → API
# The anon key is public. Never put the service-role key in the phone app
# or in a NEXT_PUBLIC_ / EXPO_PUBLIC_ variable.
# MemoAi project URL. The anon key stays blank here; copy it from
# Project Settings → API into the untracked env file. Do not commit it.
EXPO_PUBLIC_SUPABASE_URL=https://zgnzdjrnaznbpcrwsdai.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://zgnzdjrnaznbpcrwsdai.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional public URL of the deployed notes route. Not a secret.
# Leave empty until the web app is deployed. The phone sends the user's
# access token, never the worker secret.
EXPO_PUBLIC_NOTES_API_URL=

# Server only. Set these in the worker host's dashboard, not in git.
# SUPABASE_URL=https://zgnzdjrnaznbpcrwsdai.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# MEMOAI_WORKER_SECRET=
# MEMOAI_STEP_BUDGET_MS=240000
# Leave MEMOAI_ALLOW_PROVIDER unset. Set it to 1 only for an intentional paid run.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_NOTES_MODEL=gpt-4.1-mini
