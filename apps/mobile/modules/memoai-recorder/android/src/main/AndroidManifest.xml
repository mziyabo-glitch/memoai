<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.memoai.recovery"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/memoai_recovery_paths" />
    </provider>
    <service
      android:name="expo.modules.memoairecorder.MemoAiRecorderService"
      android:exported="false"
      android:foregroundServiceType="microphone"
      android:stopWithTask="false" />

    <receiver
      android:name="expo.modules.memoairecorder.StopRecordingReceiver"
      android:exported="false" />
  </application>
</manifest>
